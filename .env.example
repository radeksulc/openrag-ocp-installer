# Copy this file to .env and fill in the values below. .env is gitignored --
# your OpenAI key and any other secrets never get committed.
#
# Cluster login is NOT handled here -- run `oc login ...` yourself before
# running install.sh.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your OpenAI API key (used for both chat and embeddings).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Namespace / project
# ---------------------------------------------------------------------------

NAMESPACE=openrag

# ---------------------------------------------------------------------------
# Source of the operator/Helm chart (kubernetes/operator + kubernetes/helm/operator)
# ---------------------------------------------------------------------------

# Leave empty to auto shallow-clone langflow-ai/openrag into ./openrag-src.
# Set to a path if you already have a clone checked out.
OPENRAG_REPO_PATH=

# Git ref to check out for the CRD/Helm chart source. NOTE: this does NOT pin
# the published container images (langflowai/openrag-*:latest) to a matching
# commit -- see README "Known limitation: image/flow version skew".
OPENRAG_REPO_REF=main

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Leave empty to auto-detect the cluster's default StorageClass.
STORAGE_CLASS=

POSTGRES_STORAGE_SIZE=5Gi
OPENSEARCH_STORAGE_SIZE=20Gi
BACKEND_STORAGE_SIZE=10Gi
LANGFLOW_STORAGE_SIZE=10Gi
DOCLING_STORAGE_SIZE=10Gi
VALKEY_STORAGE_SIZE=2Gi

# ---------------------------------------------------------------------------
# LLM / embedding models
# ---------------------------------------------------------------------------

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# ---------------------------------------------------------------------------
# Resource sizing (tested working values from a live TechZone deployment --
# adjust for your cluster's actual capacity)
# ---------------------------------------------------------------------------

LANGFLOW_CPU_REQUEST=500m
LANGFLOW_CPU_LIMIT=2
LANGFLOW_MEM_REQUEST=2Gi
LANGFLOW_MEM_LIMIT=4Gi

BACKEND_CPU_REQUEST=500m
BACKEND_CPU_LIMIT=2
BACKEND_MEM_REQUEST=2Gi
BACKEND_MEM_LIMIT=8Gi

FRONTEND_CPU_REQUEST=200m
FRONTEND_CPU_LIMIT=1
FRONTEND_MEM_REQUEST=512Mi
FRONTEND_MEM_LIMIT=1Gi

DOCLING_SERVE_CPU_REQUEST=2
DOCLING_SERVE_CPU_LIMIT=4
DOCLING_SERVE_MEM_REQUEST=4Gi
DOCLING_SERVE_MEM_LIMIT=8Gi

DOCLING_WORKER_CPU_REQUEST=500m
DOCLING_WORKER_CPU_LIMIT=2
DOCLING_WORKER_MEM_REQUEST=2Gi
DOCLING_WORKER_MEM_LIMIT=4Gi

# ---------------------------------------------------------------------------
# Optional toggles
# ---------------------------------------------------------------------------

# Deploy docling-serve/docling-worker/Valkey via the CR (document upload/OCR).
ENABLE_DOCLING=true

# Create OpenShift Routes for the frontend and Langflow.
CREATE_ROUTES=true
